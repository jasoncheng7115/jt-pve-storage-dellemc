#!/usr/bin/perl
# Read a VM configuration back out of a Dell EMC config backup volume.
# Copyright (c) 2026 Jason Cheng (Jason Tools)
# Licensed under the MIT License

use strict;
use warnings;

use Getopt::Long qw(:config no_ignore_case bundling);
use File::Temp ();
use POSIX ();

use PVE::Storage::Custom::DellEMC::Common::Naming;
use PVE::Storage::Custom::DellEMC::PowerStore::API;
use PVE::Storage::Custom::DellEMC::PowerStore::Naming;
use PVE::Storage::Custom::DellEMC::Common::ISCSI qw(
    get_initiator_name probe_portal discover_targets login_target
);
use PVE::Storage::Custom::DellEMC::Common::FC qw(
    is_fc_available get_fc_wwpns
);
use PVE::Storage::Custom::DellEMC::Common::Multipath qw(
    wait_for_multipath_device get_device_by_wwid cleanup_lun_devices
    is_block_device
);

# Every snapshot taken by this plugin also writes the VM's configuration to a
# 1 MB volume beside the disk, because a storage snapshot restores the disk
# and nothing else — the configuration lives in /etc/pve.
#
# This tool reads those volumes back. It deliberately does NOT go through
# pvesm or the PVE storage layer: the situation it exists for is the one where
# /etc/pve is gone or pvedaemon will not start. It parses storage.cfg itself
# when it can, and takes credentials on the command line when it cannot.

my $VERSION = '0.8.26~beta1';

my $NAMING = 'PVE::Storage::Custom::DellEMC::PowerStore::Naming';

sub usage {
    my ($exit) = @_;

    print <<"EOF";
pve-dell-config-get $VERSION - recover VM configurations from Dell EMC storage

Usage:
  pve-dell-config-get [options] <storeid> [vmid] [snapshot]
  pve-dell-config-get -l [options] <storeid> [vmid]

Options:
  -l, --list             List the config backups on the storage and exit
  -o, --output FILE      Write the configuration to FILE instead of stdout
  -r, --recover          Standalone mode: do not read /etc/pve/storage.cfg,
                         take the array details from the options below
      --portal HOST      Array management address       (recover mode)
      --username USER    REST API user                  (recover mode)
      --password PASS    REST API password              (recover mode)
      --protocol PROTO   iscsi (default) or fc          (recover mode)
      --cluster NAME     Cluster name used in host names, default 'pve'
      --host-mode MODE   'per-node' (default) or 'shared', matching the
                         storage's dell-host-mode. Read from storage.cfg when
                         it is available; get it wrong and this tool looks for
                         the wrong host object on the array
      --insecure         Do not verify the array's TLS certificate. This is
                         already the default in recover mode, matching the
                         plugin's own dell-ssl-verify default
      --verify-ssl       Do verify it. Recovery usually runs against an array
                         with a self-signed certificate, so this is off by
                         default; turn it on when the array has a certificate
                         your node trusts
      --timeout SECONDS  Device wait timeout, default 60
  -q, --quiet            Only print the configuration itself
  -h, --help             This text

Examples:
  # What is available for VM 100
  pve-dell-config-get -l ps1 100

  # Restore the configuration captured with snapshot 'before-upgrade'
  pve-dell-config-get ps1 100 before-upgrade > /etc/pve/qemu-server/100.conf

  # /etc/pve is gone: talk to the array directly
  pve-dell-config-get -r --portal 10.0.0.5 --username pveadmin \\
      --password secret ps1 100 before-upgrade

The volume is mounted read-only for the duration. If this tool attached it, it
detaches it again afterwards, including when it fails partway. A volume that
was already mapped to this node is left as it was found.
EOF

    exit($exit // 0);
}

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------

my %opt = (protocol => 'iscsi', cluster => 'pve', timeout => 60);

GetOptions(
    'l|list'       => \$opt{list},
    'o|output=s'   => \$opt{output},
    'r|recover'    => \$opt{recover},
    'portal=s'     => \$opt{portal},
    'username=s'   => \$opt{username},
    'password=s'   => \$opt{password},
    'protocol=s'   => \$opt{protocol},
    'cluster=s'    => \$opt{cluster},
    'host-mode=s'  => \$opt{host_mode},
    'insecure'     => \$opt{insecure},
    'verify-ssl'   => \$opt{verify_ssl},
    'timeout=i'    => \$opt{timeout},
    'q|quiet'      => \$opt{quiet},
    'h|help'       => \$opt{help},
) or usage(1);

usage(0) if $opt{help};

my ($storeid, $vmid, $snapshot) = @ARGV;
usage(1) unless defined $storeid;

die "vmid must be a number\n" if defined $vmid && $vmid !~ /^\d+$/;

sub info {
    my ($message) = @_;
    print STDERR "$message\n" unless $opt{quiet};
    return;
}

# ---------------------------------------------------------------------------
# Storage configuration
#
# Parsed here rather than through PVE::Storage on purpose: this tool has to
# work when the PVE stack does not.
# ---------------------------------------------------------------------------

# Where the tool looks for what PVE keeps. Overridable so the test suite can
# drive the real script against a temporary tree; it changes nothing about
# what the tool may do, which is whatever root may do either way.
my $PVE_ROOT = $ENV{PVE_DELL_CONFIG_ROOT} // '/etc/pve';

# The array password, which since 0.7.86 lives OUTSIDE storage.cfg.
#
# The plugin writes it to /etc/pve/priv/storage/<storeid>.pw, mode 0600, and
# deletes it from storage.cfg — /etc/pve/storage.cfg is readable by the
# www-data group and replicated to every node, and a password does not belong
# in it. This tool parses storage.cfg itself rather than going through PVE, so
# it has to know the same thing: without this it reported "no credentials
# configured" for every storage created or updated on 0.7.86 or later, which
# is to say for every storage following the current convention, at the moment
# someone is trying to recover a VM configuration.
#
# Same precedence as the plugin: the priv file wins, storage.cfg is the
# fallback for a storage that has not been updated yet.
sub read_priv_password {
    my ($storeid) = @_;

    return undef unless defined $storeid && length $storeid;

    # The plugin names the file with the storeid verbatim, and PVE's own
    # storage-id schema already excludes anything else. This fold changes
    # nothing for a legal id and refuses to turn a hand-typed argument into a
    # path: this tool takes the storeid from the command line, and reading an
    # arbitrary file as root is not something it should be able to be talked
    # into.
    (my $safe = $storeid) =~ s/[^A-Za-z0-9._-]/_/g;
    return undef unless length $safe;

    my $file = "$PVE_ROOT/priv/storage/$safe.pw";
    open(my $fh, '<', $file) or return undef;
    my $password = do { local $/; <$fh> };
    close($fh);

    return undef unless defined $password;
    chomp $password;

    return length($password) ? $password : undef;
}

sub read_storage_cfg {
    my ($want) = @_;

    my $file = "$PVE_ROOT/storage.cfg";
    open(my $fh, '<', $file) or return undef;

    my ($current, %config);
    while (my $line = <$fh>) {
        chomp $line;
        next if $line =~ /^\s*#/;

        if ($line =~ /^(\S+):\s*(\S+)\s*$/) {
            my ($type, $id) = ($1, $2);
            $current = ($id eq $want && $type =~ /^dell/) ? {} : undef;
            $config{type} = $type if $current;
            next;
        }

        next unless $current;
        next unless $line =~ /^\s+(\S+)\s+(.*?)\s*$/;
        $config{$1} = $2;
    }
    close($fh);

    return keys(%config) ? \%config : undef;
}

my $scfg;

if ($opt{recover}) {
    for my $required (qw(portal username password)) {
        die "--$required is required in recover mode\n" unless defined $opt{$required};
    }
    $scfg = {
        'dell-portal'       => $opt{portal},
        'dell-username'     => $opt{username},
        'dell-password'     => $opt{password},
        'dell-protocol'     => $opt{protocol},
        'dell-cluster-name' => $opt{cluster},
        # Off unless asked for. Recovery is normally run against an array
        # with a self-signed certificate, and a certificate error at that
        # moment is an obstacle, not a protection. --insecure is accepted for
        # people who type it out of habit and is what happens anyway.
        'dell-ssl-verify'   => ($opt{verify_ssl} && !$opt{insecure}) ? 1 : 0,
    };
} else {
    $scfg = read_storage_cfg($storeid);
    unless ($scfg) {
        die "Storage '$storeid' was not found in $PVE_ROOT/storage.cfg.\n"
          . "If PVE is not available, use recover mode:\n"
          . "  pve-dell-config-get -r --portal <ip> --username <user>"
          . " --password <pass> $storeid"
          . (defined $vmid ? " $vmid" : '') . "\n";
    }
    my $priv = read_priv_password($storeid);
    $scfg->{'dell-password'} = $priv if defined $priv;

    # Command-line credentials still win, for the case where storage.cfg is
    # readable but its password is not the one that works.
    $scfg->{'dell-portal'}   = $opt{portal}   if defined $opt{portal};
    $scfg->{'dell-username'} = $opt{username} if defined $opt{username};
    $scfg->{'dell-password'} = $opt{password} if defined $opt{password};
    $scfg->{'dell-ssl-verify'} = 0 if $opt{insecure};
    $scfg->{'dell-ssl-verify'} = 1 if $opt{verify_ssl} && !$opt{insecure};
}

die "Storage '$storeid' has no dell-portal configured\n"
    unless $scfg->{'dell-portal'};
die "Storage '$storeid' has no credentials configured. The password is kept"
  . " in $PVE_ROOT/priv/storage/, which this tool reads, and it is not there"
  . " either. Pass --username and --password.\n"
    unless $scfg->{'dell-username'} && defined $scfg->{'dell-password'};

# This tool speaks PowerStore REST. Pointed at another family it would send
# PowerStore requests to an array that does not understand them and report
# something unhelpful, so say plainly what is going on instead. The config
# backup volume it reads only exists on PowerStore anyway: PowerVault ME does
# not offer the feature, because one extra volume per snapshot is too much for
# that family's volume ceiling.
my $type = $scfg->{type};
if (defined $type && $type ne 'dellpowerstore') {
    die "Storage '$storeid' is of type '$type'. This tool reads the VM config"
      . " backup volume, which only the dellpowerstore family creates.\n"
      . ($type eq 'dellpowervault'
         ? "  PowerVault ME does not offer the config backup: it would cost one"
         . " extra volume per snapshot, and that family's volume ceiling is too"
         . " low for it.\n"
         : $type eq 'dellunity'
         ? "  Unity's config backup is off until the family has passed a run on"
         . " real hardware: a family whose device discovery has never been"
         . " confirmed should not be creating volumes nobody asked for.\n"
         : '')
      . "  Recover the VM configuration from a PVE backup, or from /etc/pve on"
      . " another node of the cluster.\n";
}

my $protocol = $scfg->{'dell-protocol'} // 'iscsi';
my $cluster  = $scfg->{'dell-cluster-name'} // 'pve';

# ---------------------------------------------------------------------------
# Array connection
# ---------------------------------------------------------------------------

my $api = PVE::Storage::Custom::DellEMC::PowerStore::API->new(
    portal     => $scfg->{'dell-portal'},
    username   => $scfg->{'dell-username'},
    password   => $scfg->{'dell-password'},
    ssl_verify => $scfg->{'dell-ssl-verify'} // 0,
    storeid    => $storeid,
    type       => 'dellpowerstore',
);

# Run a command with a bound on how long it may block, and return its exit
# code (-1 if it never finished). This tool runs during an outage, against
# storage that may be half dead: an unbounded mount of a device whose paths
# have gone away never returns, and the operator is left with no output and no
# way to tell what is happening.
sub run_bounded {
    my ($cmd, $timeout) = @_;

    $timeout ||= 30;

    my $pid = fork();
    unless (defined $pid) {
        print STDERR "Warning: cannot fork to run @$cmd: $!\n";
        return -1;
    }

    if ($pid == 0) {
        # Child: replace itself with the command. C locale, so that a mount
        # failure reads the same on every node — recovery is not the moment
        # to be handed a message nobody here can paste into a search.
        $ENV{LC_ALL} = 'C';
        $ENV{LANG}   = 'C';
        exec(@$cmd) or POSIX::_exit(127);
    }

    my $deadline = time() + $timeout;
    while (time() < $deadline) {
        my $reaped = waitpid($pid, POSIX::WNOHANG());
        return $? >> 8 if $reaped == $pid;
        return -1 if $reaped < 0;
        select(undef, undef, undef, 0.1);
    }

    print STDERR "Warning: '@$cmd' did not finish within ${timeout}s\n";
    kill('TERM', $pid);
    select(undef, undef, undef, 0.5);
    kill('KILL', $pid);
    waitpid($pid, POSIX::WNOHANG());

    return -1;
}

sub nodename {
    # /etc/hostname rather than PVE::INotify: this must work without PVE.
    if (open(my $fh, '<', '/etc/hostname')) {
        my $name = <$fh>;
        close($fh);
        if (defined $name) {
            chomp $name;
            $name =~ s/\..*$//;
            return $name if length $name;
        }
    }

    return (POSIX::uname())[1] =~ /^([^.]+)/ ? $1 : 'unknown';
}

# The host object this node is mapped to, named exactly as the plugin names
# it — including 'shared'.
#
# BlockBase::_host_name registers one host per node by default and a single
# shared host for the whole cluster when 'dell-host-mode shared' is set. This
# tool read neither the option nor the mode and always built the per-node
# name, so against a storage using the shared mode it looked for a host that
# does not exist and then CREATED one, with this node's initiators in it. An
# initiator belongs to one host object on these arrays: registering it again
# under a new name is refused at best, and at worst moves it off the shared
# host that every node's volumes are mapped to. That is a recovery tool
# taking a cluster's storage down while someone is recovering a VM.
my $host_mode = $opt{host_mode} // $scfg->{'dell-host-mode'} // 'per-node';
die "--host-mode must be 'per-node' or 'shared'\n"
    unless $host_mode eq 'per-node' || $host_mode eq 'shared';

my $host_name = $NAMING->encode_host_name($cluster,
    $host_mode eq 'shared' ? undef : nodename());

# Said out loud, on stderr, before anything is done with it. Which host object
# the tool will look for is the one thing an operator can check against the
# array in five seconds, and getting it wrong is how this tool would create a
# second host and move an initiator off the one in use.
info("Host object for this node: '$host_name' ($host_mode)");

# ---------------------------------------------------------------------------
# Listing
# ---------------------------------------------------------------------------

my $prefix = $NAMING->volume_prefix($storeid);
$prefix .= "${vmid}-vmconf-" if defined $vmid;

sub list_backups {
    # $prefix already narrows to one VM when a vmid was given.
    my $volumes = $api->volume_list($prefix) // [];

    my @backups;
    for my $volume (@$volumes) {
        my $decoded = $NAMING->decode_volume_name($volume->{name}) or next;
        next unless $decoded->{type} eq 'vmconf';
        next if defined $vmid && $decoded->{vmid} != $vmid;
        push @backups, {
            name     => $volume->{name},
            id       => $volume->{id},
            vmid     => $decoded->{vmid},
            snapshot => $decoded->{snapname},
            wwn      => $volume->{wwn},
        };
    }

    return [ sort { $a->{vmid} <=> $b->{vmid} || $a->{snapshot} cmp $b->{snapshot} }
             @backups ];
}

if ($opt{list}) {
    my $backups = list_backups();

    unless (@$backups) {
        print STDERR "No configuration backups found on storage '$storeid'"
            . (defined $vmid ? " for VM $vmid" : '') . ".\n";
        exit(1);
    }

    printf("%-8s %-30s %s\n", 'VMID', 'SNAPSHOT', 'VOLUME');
    printf("%-8s %-30s %s\n", $_->{vmid}, $_->{snapshot}, $_->{name}) for @$backups;

    exit(0);
}

# ---------------------------------------------------------------------------
# Reading one backup
# ---------------------------------------------------------------------------

die "A vmid is required unless --list is used.\n" unless defined $vmid;

my $backups = list_backups();
unless (@$backups) {
    die "No configuration backup found for VM $vmid on storage '$storeid'.\n"
      . "Run with --list to see what is available.\n";
}

my $chosen;
if (defined $snapshot) {
    # The snapshot name went through sanitizing when the volume was created,
    # so compare against the encoded form as well as the literal one.
    my $wanted = $NAMING->encode_config_volume_name($storeid, $vmid, $snapshot);
    ($chosen) = grep { $_->{name} eq $wanted || $_->{snapshot} eq $snapshot } @$backups;

    unless ($chosen) {
        die "No configuration backup for snapshot '$snapshot' of VM $vmid.\n"
          . "Available: " . join(', ', map { $_->{snapshot} } @$backups) . "\n";
    }
} elsif (@$backups == 1) {
    $chosen = $backups->[0];
} else {
    die "VM $vmid has " . scalar(@$backups) . " configuration backups; name the"
      . " snapshot to use.\n"
      . "Available: " . join(', ', map { $_->{snapshot} } @$backups) . "\n";
}

info("Using volume $chosen->{name}");

# Log in to the SAN, so the volume can appear at all.
sub ensure_transport {
    return if $protocol eq 'fc';

    my $portals = eval { $api->iscsi_portals() } // [];
    unless (@$portals) {
        die "The array published no iSCSI portals. If this node uses Fibre"
          . " Channel, pass --protocol fc.\n";
    }

    for my $portal (@$portals) {
        my ($ip, $port) = split(/:/, $portal->{portal});
        $port //= 3260;
        next unless probe_portal($ip, $port, timeout => 2);
        eval {
            discover_targets($ip, port => $port);
            login_target($ip, $portal->{iqn}, port => $port);
        };
        info("Portal $ip:$port: $@") if $@;
    }

    return;
}

# Register this node if it is not on the array yet: after a reinstall it will
# not be, and that is exactly when this tool gets used.
sub ensure_host {
    my $host = eval { $api->host_get_by_name($host_name) };
    return $host->{id} if $host;

    my $initiators;
    if ($protocol eq 'fc') {
        die "Protocol 'fc' was selected but this node has no FC HBA.\n"
            unless is_fc_available();
        # Colon-separated, as PowerStore requires; see _initiator_records in
        # DellPowerStorePlugin.
        my $wwpns = get_fc_wwpns(online_only => 1);
        die "No online FC HBA ports on this node.\n" unless @$wwpns;
        $initiators = [ map { { port_name => $_, port_type => 'FC' } } @$wwpns ];
    } else {
        $initiators = [ { port_name => get_initiator_name(), port_type => 'iSCSI' } ];
    }

    info("Registering host '$host_name' on the array");

    return $api->host_create($host_name, $initiators);
}

my $host_id = ensure_host();
ensure_transport();

my $wwid = PVE::Storage::Custom::DellEMC::PowerStore::API->wwn_to_wwid($chosen->{wwn});
die "The array reported no usable WWN for volume $chosen->{name}\n" unless $wwid;

# Everything below has to be undone even when it fails partway, or the node is
# left with a mapped volume and a mount.
my $attached = 0;
my $mounted;

sub cleanup {
    if ($mounted) {
        run_bounded(['/bin/umount', $mounted], 30) == 0
            or run_bounded(['/bin/umount', '-l', $mounted], 15) == 0
            or print STDERR "Warning: could not unmount $mounted\n";
        rmdir($mounted);
        $mounted = undef;
    }
    if ($attached) {
        eval { cleanup_lun_devices($wwid) };
        eval { $api->volume_detach($chosen->{id}, host_id => $host_id) };
        $attached = 0;
    }
    return;
}

END { cleanup() }
$SIG{$_} = sub { cleanup(); exit(1) } for qw(INT TERM HUP);

my $config;

my $ok = eval {
    # Only what this tool attached is detached again on the way out. A volume
    # that was already mapped was mapped by someone else, for a reason this
    # tool does not know, and unmapping it on exit would be a change nobody
    # asked for.
    unless ($api->is_mapped($chosen->{id}, $host_id)) {
        info("Attaching the volume to this node");
        $api->volume_attach($chosen->{id}, host_id => $host_id);
        $attached = 1;
    }

    info("Waiting for the device (WWID $wwid)");
    my $device = get_device_by_wwid($wwid);
    $device = wait_for_multipath_device($wwid, timeout => $opt{timeout})
        unless $device && is_block_device($device);

    die "The device for WWID $wwid did not appear within $opt{timeout}s.\n"
      . "  Check that this node can reach the array over $protocol, and that\n"
      . "  multipathd is running.\n" unless $device && is_block_device($device);

    $mounted = File::Temp::tempdir('/tmp/pve-dell-config-XXXXXX');

    # Read-only, and noload so a dirty journal does not stop the mount: the
    # volume was written once and never touched again.
    run_bounded(['/bin/mount', '-o', 'ro,noload', $device, $mounted], 60) == 0
        or run_bounded(['/bin/mount', '-o', 'ro', $device, $mounted], 60) == 0
        or die "Could not mount $device. The volume should hold a small ext4\n"
             . "  filesystem written by the plugin; if it does not, the backup\n"
             . "  never completed for this snapshot.\n";

    my $path = "$mounted/${vmid}.conf";
    open(my $fh, '<', $path) or die "The volume holds no ${vmid}.conf: $!\n";
    local $/;
    $config = <$fh>;
    close($fh);

    if (!$opt{quiet} && open(my $mfh, '<', "$mounted/metadata.txt")) {
        info('--- backup metadata ---');
        while (my $line = <$mfh>) {
            chomp $line;
            info("  $line");
        }
        close($mfh);
        info('-----------------------');
    }

    1;
};
my $error = $@;

cleanup();

die $error unless $ok;

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

if ($opt{output}) {
    open(my $fh, '>', $opt{output}) or die "Cannot write $opt{output}: $!\n";
    print $fh $config;
    close($fh);
    info("Configuration written to $opt{output}");
} else {
    print $config;
}

exit(0);

__END__

=head1 NAME

pve-dell-config-get - recover a VM configuration from a Dell EMC config
backup volume

=head1 DESCRIPTION

Each snapshot this plugin takes also writes the VM's configuration to a 1 MB
volume beside the disk, because a storage snapshot restores the disk and
nothing else.

This tool reads those volumes back. It parses /etc/pve/storage.cfg directly
and talks to the array itself rather than going through pvesm, so it still
works when the PVE stack does not. With C<--recover> it does not read
storage.cfg at all and takes the array details from its options.

The volume is mounted read-only for the duration. If this tool attached it, it
detaches it again afterwards — including on failure and on SIGINT. A volume
that was already mapped to this node is left mapped, because something else
put it there.

=head1 AUTHOR

Jason Cheng (Jason Tools) <jason@jason.tools>

=head1 LICENSE

MIT License

=cut
